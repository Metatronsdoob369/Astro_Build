---
// [ 02 : DESIGN DEPT. ] — proof of craft, quiet.
// This section is the pitch: no stock photos, no fictional clients.
import TopoField from "./TopoField.astro";

const swatches = [
  { name: "CHARCOAL", hex: "#0E0E10" },
  { name: "SLATE", hex: "#1A1A1C" },
  { name: "STONE", hex: "#A8A8A2" },
  { name: "ASH", hex: "#8A867C" },
  { name: "SILVER", hex: "#ECECE8" },
];
---

<section class="section" id="design">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="idx">[ 02 : DESIGN DEPT. ]</span>
      <span class="name">Websites, obviously</span>
    </div>
    <p class="sec-lede" data-reveal>
      This page is the pitch. Not a template shop. The work is the respect:
      you can see the effort. Same system on every client site we open the
      door with — then the optimizer, then the paint of their data.
    </p>

    <!-- ── quiet panel: site-as-proof, no props ── -->
    <article class="panel quiet" data-reveal>
      <div class="quiet-field">
        <TopoField seed={9} w={1440} h={320} cols={72} rows={28} levels={6} opacity={0.18} indexOpacity={0.36} preserve="xMidYMid slice" />
      </div>
      <div class="quiet-copy">
        <h3 class="quiet-title">No props. No templates.</h3>
        <p class="quiet-lede mono">
          This site is the proof — system, typography, and rhythm.
          No stock photos. No fictional clients.
        </p>
      </div>
    </article>

    <!-- the system itself, on display -->
    <div class="panel specimen" data-reveal>
      <div class="spec-swatches">
        {swatches.map((s) => (
          <div class="swatch">
            <span class="sw" style={`--c: ${s.hex}`}></span>
            <span class="mono sw-name">{s.hex}</span>
            <span class="mono sw-name strong">{s.name}</span>
          </div>
        ))}
      </div>
      <div class="spec-type">
        <span class="spec-aa">Aa</span>
        <div class="spec-type-copy">
          <p class="spec-line">Systems with a sine of life.</p>
          <p class="mono spec-meta">SYNE 800 / DISPLAY — INTER 400 / BODY — PLEX MONO / FIELD LABELS</p>
        </div>
      </div>
      <div class="spec-note mono">
        [ EVERY SITE WE SHIP CARRIES THIS SPEC CARD — INCLUDING YOURS ]
      </div>
    </div>
  </div>
</section>

<style>
  /* ── the bento: wide rectangles, product first ── */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(16px, 2vw, 24px);
    margin-bottom: clamp(28px, 3.5vw, 44px);
    align-items: stretch;
  }

  .cell {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .s4 { grid-column: span 4; }
  .s2 { grid-column: span 2; }

  .browser {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 14px;
    background: var(--layer-elevated);
    border-bottom: 1px solid var(--line-soft);
    flex-shrink: 0;
  }
  .b-dots { display: flex; gap: 6px; }
  .b-dots i {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
  }
  .b-url {
    flex: 1;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    padding: 3px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .b-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--olive);
  }

  .browser-view {
    flex: 1;
    min-height: 230px;
    overflow: hidden;
    position: relative;
  }
  .browser-view img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .cell:hover .browser-view img { transform: scale(1.035); }

  /* ── quiet panel ── */
  .quiet {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: clamp(28px, 3.5vw, 44px);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    overflow: hidden;
    background: var(--layer);
  }
  .quiet-field { width: 100%; height: auto; background: var(--bg); }
  .quiet-copy { padding: clamp(16px, 2.2vw, 24px); display: grid; gap: 8px; }
  .quiet-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .quiet-lede { color: var(--muted); font-size: 13.5px; }

  /* spec strip — compact, horizontal */
  .spec {
    padding: 15px 18px 17px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex-shrink: 0;
  }
  .spec-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .b-client {
    font-size: 16.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .b-sector { color: var(--ember); font-size: 9.5px; letter-spacing: 0.2em; }
  .b-result {
    color: var(--muted);
    font-size: 13.5px;
  }
  .featured .tags { margin-top: 7px; }
  .s2 .b-result { font-size: 13px; }
  .s2 .stat-chip { display: none; }

  /* platform — wide anchor, media left / copy right */
  .platform {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }
  .platform-media {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--line-soft);
  }
  .platform-media .browser-view { min-height: 250px; }
  .platform-copy {
    padding: clamp(20px, 2.4vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
    min-width: 0;
  }
  .platform-copy .b-result { font-size: 14px; }
  .platform-copy .tags { margin-top: 6px; }

  /* ── the spec card ── */
  .specimen {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(24px, 3vw, 44px);
    padding: clamp(26px, 3.4vw, 44px);
    align-items: center;
  }
  .spec-swatches { display: flex; gap: clamp(10px, 1.6vw, 20px); flex-wrap: wrap; }
  .swatch { display: flex; flex-direction: column; gap: 7px; width: 86px; }
  .sw {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 4px;
    background: var(--c);
    border: 1px solid var(--line-soft);
    box-shadow: inset 0 0 0 3px var(--bg-raised);
    transition: transform 0.25s ease;
  }
  .swatch:hover .sw { transform: translateY(-3px); }
  .sw-name { font-size: 9px; letter-spacing: 0.14em; color: var(--faint); }
  .sw-name.strong { color: var(--ink); }

  .spec-type {
    display: flex;
    align-items: center;
    gap: 22px;
    border-left: 1px dashed var(--line);
    padding-left: clamp(22px, 3vw, 40px);
  }
  .spec-aa {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(64px, 7vw, 96px);
    line-height: 1;
    color: var(--ink);
  }
  .spec-line {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .spec-meta { font-size: 9px; letter-spacing: 0.18em; color: var(--faint); line-height: 1.9; }

  .spec-note {
    grid-column: 1 / -1;
    border-top: 1px dashed var(--line-soft);
    padding-top: 20px;
    text-align: center;
    color: var(--ember);
    font-size: 10px;
    letter-spacing: 0.22em;
  }

  /* ── responsive ── */
  @media (max-width: 1020px) {
    .s4 { grid-column: span 6; }
    .s2 { grid-column: span 3; }
    .platform { grid-template-columns: 1fr; }
    .platform-media { border-right: none; border-bottom: 1px solid var(--line-soft); }
    .specimen { grid-template-columns: 1fr; }
    .spec-type { border-left: none; border-top: 1px dashed var(--line); padding-left: 0; padding-top: 24px; }
  }
  @media (max-width: 620px) {
    .s2 { grid-column: span 6; }
    .browser-view { min-height: 200px; }
  }
</style>
