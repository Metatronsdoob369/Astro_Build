---
// [ 02 : DESIGN DEPT. ] — proof of craft. A studio pushing web design
// has to show web design. Exhibit A is the site you're reading.
const builds = [
  {
    img: "/mockups/drift-coffee.jpg",
    alt: "Drift & Ember — specialty coffee roastery website",
    client: "DRIFT & EMBER",
    sector: "Specialty coffee roastery",
    stat: "[ BUILD: 2025 | ASTRO + HEADLESS ]",
    result: "+61% online orders in 90 days",
    stack: ["Sub-second loads", "Headless CMS", "0 templates"],
  },
  {
    img: "/mockups/sunbelt-field.jpg",
    alt: "Sunbelt Field Services — HVAC & electrical contractor website",
    client: "SUNBELT FIELD SERVICES",
    sector: "HVAC & electrical contractor",
    stat: "[ BUILD: 2025 | ASTRO + N8N INTAKE ]",
    result: "9-minute emergency intake, start to dispatch",
    stack: ["Tactical utility", "n8n intake flows", "Local SEO"],
  },
  {
    img: "/mockups/meridian-arch.jpg",
    alt: "Meridian A+D — architecture studio portfolio website",
    client: "MERIDIAN A+D",
    sector: "Architecture studio",
    stat: "[ BUILD: 2024 | ASTRO + SANITY ]",
    result: "Portfolio updates 3× faster, no developer",
    stack: ["Editorial grid", "Sanity backend", "Print-grade type"],
  },
];

const swatches = [
  { name: "BONE", hex: "#F2EFE7" },
  { name: "COYOTE", hex: "#B7A48A" },
  { name: "RANGER", hex: "#5B6550" },
  { name: "GRAPHITE", hex: "#2E3236" },
  { name: "EMBER", hex: "#C2551F" },
];
---

<section class="section" id="design">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="idx">[ 02 : DESIGN DEPT. ]</span>
      <span class="name">Websites, obviously</span>
    </div>
    <p class="sec-lede" data-reveal>
      A studio that pushes web design has to <strong>show web design</strong>.
      Every build below comes off the same system you&rsquo;re reading right
      now — bone paper, ranger green, one ember accent, zero templates.
      Exhibit A: this page.
    </p>

    <div class="builds">
      {builds.map((b, i) => (
        <article class="panel build" data-reveal data-reveal-delay={String(i)}>
          <div class="browser">
            <div class="browser-bar">
              <span class="b-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="b-url mono">{b.client.toLowerCase().replace(/[^a-z0-9]+/g, "")}.com</span>
              <span class="b-live mono"><span class="pulse-dot"></span> LIVE</span>
            </div>
            <div class="browser-view">
              <img src={b.img} alt={b.alt} loading="lazy" width="1024" height="1024" />
            </div>
          </div>

          <div class="build-spec">
            <div class="spec-row">
              <h3 class="b-client">{b.client}</h3>
              <span class="stat-chip">{b.stat}</span>
            </div>
            <p class="b-sector mono">{b.sector}</p>
            <p class="b-result">{b.result}</p>
            <ul class="tags">
              {b.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- the system itself, on display -->
    <div class="panel specimen" data-reveal>
      <div class="spec-swatches">
        {swatches.map((s) => (
          <div class="swatch">
            <span class="sw" style={`--c: ${s.hex}`}></span>
            <span class="mono sw-name">{s.hex}</span>
            <span class="mono sw-name strong">{s.name}</span>
          </div>
        ))}
      </div>
      <div class="spec-type">
        <span class="spec-aa">Aa</span>
        <div class="spec-type-copy">
          <p class="spec-line">Systems with a sine of life.</p>
          <p class="mono spec-meta">SYNE 800 / DISPLAY — INTER 400 / BODY — PLEX MONO / FIELD LABELS</p>
        </div>
      </div>
      <div class="spec-note mono">
        [ EVERY SITE WE SHIP CARRIES THIS SPEC CARD — INCLUDING YOURS ]
      </div>
    </div>
  </div>
</section>

<style>
  .builds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.6vw, 34px);
    margin-bottom: clamp(28px, 3.5vw, 44px);
  }

  .build { display: flex; flex-direction: column; }

  .browser { border-bottom: 1px solid var(--line-soft); }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    background: var(--layer-elevated);
    border-bottom: 1px solid var(--line-soft);
  }
  .b-dots { display: flex; gap: 6px; }
  .b-dots i {
    width: 8px; height: 8px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
  }
  .b-url {
    flex: 1;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    padding: 3px 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .b-live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--olive);
  }

  .browser-view { overflow: hidden; }
  .browser-view img {
    width: 100%;
    aspect-ratio: 4 / 3.1;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .build:hover .browser-view img { transform: scale(1.04); }

  .build-spec { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px; }
  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .b-client {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }
  .b-sector { color: var(--ember); font-size: 10px; letter-spacing: 0.2em; }
  .b-result {
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 400;
    margin-bottom: 10px;
  }

  /* ── the spec card ── */
  .specimen {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(24px, 3vw, 44px);
    padding: clamp(26px, 3.4vw, 44px);
    align-items: center;
  }
  .spec-swatches { display: flex; gap: clamp(10px, 1.6vw, 20px); flex-wrap: wrap; }
  .swatch { display: flex; flex-direction: column; gap: 7px; width: 86px; }
  .sw {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 4px;
    background: var(--c);
    border: 1px solid var(--line-soft);
    box-shadow: inset 0 0 0 3px var(--bg-raised);
    transition: transform 0.25s ease;
  }
  .swatch:hover .sw { transform: translateY(-3px); }
  .sw-name { font-size: 9px; letter-spacing: 0.14em; color: var(--faint); }
  .sw-name.strong { color: var(--ink); }

  .spec-type {
    display: flex;
    align-items: center;
    gap: 22px;
    border-left: 1px dashed var(--line);
    padding-left: clamp(22px, 3vw, 40px);
  }
  .spec-aa {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(64px, 7vw, 96px);
    line-height: 1;
    color: var(--ink);
  }
  .spec-line {
    font-family: var(--font-hero);
    font-weight: 700;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .spec-meta { font-size: 9px; letter-spacing: 0.18em; color: var(--faint); line-height: 1.9; }

  .spec-note {
    grid-column: 1 / -1;
    border-top: 1px dashed var(--line-soft);
    padding-top: 20px;
    text-align: center;
    color: var(--ember);
    font-size: 10px;
    letter-spacing: 0.22em;
  }

  @media (max-width: 980px) {
    .builds { grid-template-columns: 1fr; max-width: 620px; margin-inline: auto; }
    .specimen { grid-template-columns: 1fr; }
    .spec-type { border-left: none; border-top: 1px dashed var(--line); padding-left: 0; padding-top: 24px; }
  }
</style>
