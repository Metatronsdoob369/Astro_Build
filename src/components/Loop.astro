---
import TopoField from "./TopoField.astro";
import FieldTerminal from "./FieldTerminal.astro";
---

<!-- [ 04 : RECURSION ] — the loop behind every Recursive AiO website -->
<section class="section" id="recursion">
  <div class="container loop-grid">
    <div class="loop-copy">
      <div class="sec-head copper" data-reveal>
        <span class="idx">[ 04 : RECURSION ]</span>
        <span class="name">The Loop</span>
      </div>
      <p class="sec-lede" data-reveal>
        A website that ships once is dead infrastructure. A
        <strong>Recursive AiO website</strong> runs a closed loop forever —
        every visitor makes the next visitor&rsquo;s experience sharper.
      </p>

      <ol class="steps">
        <li data-reveal>
          <span class="mono step-num">01 / SENSE</span>
          <p>Telemetry on every session — attention, stalls, rage-clicks, conversions, escapes.</p>
        </li>
        <li data-reveal>
          <span class="mono step-num">02 / MODEL</span>
          <p>The site&rsquo;s models map which copy, layout, and flow each visitor pattern actually responds to.</p>
        </li>
        <li data-reveal>
          <span class="mono step-num">03 / REFINE</span>
          <p>It drafts the delta — sharper headlines, re-ordered sections, tighter funnels.</p>
        </li>
        <li data-reveal>
          <span class="mono step-num">04 / SERVE</span>
          <p>Improvements ship behind flags. You approve; the loop learns from the result. Repeat.</p>
        </li>
      </ol>

      <ul class="gov" data-reveal>
        <li><span class="pulse-dot"></span> Full audit trail on every change</li>
        <li><span class="pulse-dot copper"></span> Kill-switch on every node</li>
        <li><span class="pulse-dot"></span> Weekly delta reports, human-readable</li>
        <li><span class="pulse-dot copper"></span> No dark patterns — governed by contract</li>
      </ul>
    </div>

    <div class="loop-diagram" data-reveal aria-hidden="true">
      <div class="loop-topo">
        <TopoField seed={4} w={640} h={640} cols={40} rows={40} levels={7} opacity={0.3} indexOpacity={0.42} preserve="xMidYMid slice" />
      </div>
      <span class="grid-tag mono">GRID EMSJ — 1:24K</span>
      <span class="brg b1 mono">042°</span>
      <span class="brg b2 mono">131°</span>
      <span class="brg b3 mono">222°</span>
      <span class="brg b4 mono">311°</span>
      <svg class="ring" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="46" fill="none" stroke="rgba(46,50,54,0.22)" stroke-width="0.5" stroke-dasharray="3 2.4" />
        <circle class="ring-flow" cx="50" cy="50" r="46" fill="none" stroke="var(--olive)" stroke-width="0.6" stroke-dasharray="6 283" stroke-linecap="round" />
        <path d="M50 6 l-2.6 4.5 h5.2 z" fill="var(--olive)" class="ring-arrow" />
      </svg>

      <div class="loop-core">
        <span class="core-sym">cos<span>+</span></span>
        <span class="mono core-label">EVERY CYCLE<br />COMPOUNDS</span>
      </div>

      <div class="loop-node n1">
        <span class="mono">01 / SENSE</span>
      </div>
      <div class="loop-node n2">
        <span class="mono">02 / MODEL</span>
      </div>
      <div class="loop-node n3">
        <span class="mono">03 / REFINE</span>
      </div>
      <div class="loop-node n4">
        <span class="mono">04 / SERVE</span>
      </div>
    </div>
  </div>
  <!-- the hardware that watches the loop — photoreal + live telemetry -->
  <div class="container">
    <FieldTerminal />
  </div>
</section>

<style>
  .loop-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 0;
    margin-bottom: 34px;
    border-top: 1px solid var(--line-soft);
  }
  .steps li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-soft);
    align-items: baseline;
  }
  .steps p { color: var(--muted); font-size: 14.5px; font-weight: 300; }
  .step-num { color: var(--ember); font-size: 11px; letter-spacing: 0.2em; }

  .gov {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }
  .gov li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── the diagram ── */
  .loop-diagram {
    position: relative;
    aspect-ratio: 1;
    max-width: 520px;
    width: 100%;
    margin-inline: auto;
  }

  .loop-topo {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
    mask-image: radial-gradient(circle, black 55%, transparent 78%);
    -webkit-mask-image: radial-gradient(circle, black 55%, transparent 78%);
  }

  .grid-tag {
    position: absolute;
    top: -26px;
    right: 0;
    font-size: 8.5px;
    letter-spacing: 0.22em;
    color: var(--faint);
  }
  .brg {
    position: absolute;
    font-size: 8.5px;
    letter-spacing: 0.2em;
    color: var(--faint);
    background: var(--bg);
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    padding: 2px 7px;
    z-index: 2;
  }
  .b1 { top: 21%; left: 18%; }
  .b2 { top: 21%; right: 18%; }
  .b3 { bottom: 21%; right: 18%; }
  .b4 { bottom: 21%; left: 18%; }

  .ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ring-flow { animation: orbit 14s linear infinite; transform-origin: 50% 50%; }
  .ring-arrow { animation: orbit 14s linear infinite; transform-origin: 50% 50%; }
  @keyframes orbit { to { transform: rotate(360deg); } }

  .loop-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--olive-dim);
    background: rgba(18, 18, 20, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 0 40px rgba(163, 177, 138, 0.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
  }
  .core-sym {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(28px, 4vw, 44px);
    color: var(--ink);
  }
  .core-sym span { color: var(--ember); }
  .core-label { font-size: 9px; letter-spacing: 0.24em; color: var(--muted); line-height: 1.7; }

  .loop-node {
    position: absolute;
    background: var(--layer-deep);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink);
    white-space: nowrap;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    animation: nodefloat 5s ease-in-out infinite;
  }
  .loop-node:hover { border-color: var(--olive); box-shadow: 0 0 20px rgba(142, 255, 166, 0.15); }
  .n1 { top: 0; left: 50%; transform: translateX(-50%); }
  .n2 { top: 50%; right: 0; transform: translateY(-50%); animation-delay: 1.2s; }
  .n3 { bottom: 0; left: 50%; transform: translateX(-50%); animation-delay: 2.4s; }
  .n4 { top: 50%; left: 0; transform: translateY(-50%); animation-delay: 3.6s; }

  @keyframes nodefloat {
    0%, 100% { box-shadow: 0 0 0 rgba(142, 255, 166, 0); }
    50% { box-shadow: 0 0 24px -6px rgba(91, 101, 80, 0.35); }
  }

  @media (max-width: 960px) {
    .loop-grid { grid-template-columns: 1fr; }
    .gov { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .steps li { grid-template-columns: 1fr; gap: 6px; }
    .loop-diagram { max-width: 340px; }
    .loop-node { padding: 9px 12px; font-size: 9px; }
  }
</style>
