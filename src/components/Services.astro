---
const services = [
  {
    title: "WEB DESIGN",
    stat: "[ LCP: <1S | A11Y: AA+ ]",
    glyph: "frame",
    description:
      "Deterministic frontends, engineered like backends. Sub-second loads, accessible by default, hand-tuned typography — sites that rank, convert, and refuse to rot. Every build ships monitored, documented, and fast on a bad phone on a bad network.",
    tags: ["Astro / Edge-static", "Design systems", "Headless CMS", "Core Web Vitals"],
  },
  {
    title: "RECURSIVE AIO WEBSITES",
    stat: "[ LOOP: SENSE→SERVE | DELTAS: APPROVED ]",
    glyph: "loop",
    flagship: true,
    description:
      "The All-in-One website with a governor. Site, CMS, CRM, analytics, and an embedded AI layer wired into one closed loop — it observes how visitors actually use it, drafts improvements, ships them behind flags, and learns from every delta. Your website becomes an asset that compounds.",
    tags: ["AiO: site + CRM + analytics + AI", "Continuous self-optimization", "Human-approved deltas", "Full audit trail"],
  },
  {
    title: "CUSTOM AI SOLUTIONS",
    stat: "[ GOVERNANCE: STRICT | LATENCY: <50MS ]",
    glyph: "network",
    description:
      "MCP stacks, autonomous workflows (n8n + Python + LLM reasoning), redteam tooling, and synthetic media pipelines — governed architectures that execute complex tasks while you sleep, under strict parameters, without hallucinating context.",
    tags: ["Custom MCP stacks", "Autonomous workflows", "Opsec & redteaming", "Synthetic media gen"],
  },
];
---

<section class="section" id="systems">
  <div class="container">
    <div class="sec-head" data-reveal>
      <span class="idx">[ 03 : SYSTEMS ]</span>
      <span class="name">Core Systems</span>
    </div>
    <p class="sec-lede" data-reveal>
      Three deployment classes, one philosophy: <strong>governed autonomy</strong>.
      Machines do the repeating; humans hold the kill-switch; everything ships
      with an audit trail.
    </p>

    <div class="grid">
      {services.map((s, i) => (
        <article class:list={["panel", "svc", { flagship: s.flagship }]} data-reveal data-reveal-delay={i === 0 ? "0" : i}>
          <div class="svc-top">
            <div class="svc-glyph" aria-hidden="true">
              {s.glyph === "frame" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M3 9h18" />
                  <circle cx="6" cy="6" r="0.8" fill="currentColor" />
                </svg>
              )}
              {s.glyph === "loop" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17 2l4 4-4 4" />
                  <path d="M3 11v-1a4 4 0 0 1 4-4h14" />
                  <path d="M7 22l-4-4 4-4" />
                  <path d="M21 13v1a4 4 0 0 1-4 4H3" />
                </svg>
              )}
              {s.glyph === "network" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="5" cy="5" r="2.2" />
                  <circle cx="19" cy="5" r="2.2" />
                  <circle cx="12" cy="19" r="2.2" />
                  <path d="M7 6.2 L10.5 17.2 M17 6.2 L13.5 17.2 M7.2 5h9.6" stroke-dasharray="0" />
                </svg>
              )}
            </div>
            {s.flagship && <span class="mono svc-flag">FLAGSHIP</span>}
            <span class="stat-chip">{s.stat}</span>
          </div>

          <h3 class="svc-title">{s.title}</h3>
          <p class="svc-body">{s.description}</p>

          <ul class="tags">
            {s.tags.map((t) => <li>{t}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 26px);
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 2.6vw, 34px);
  }

  .svc.flagship {
    border-color: var(--ember-dim);
    box-shadow: 0 0 0 1px rgba(194, 85, 31, 0.12), 0 18px 44px -24px rgba(194, 85, 31, 0.4);
  }
  .svc.flagship:hover {
    border-color: var(--ember);
  }

  .svc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 6px;
  }

  .svc-glyph {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px dashed var(--line);
    border-radius: 6px;
    background: var(--layer-elevated);
    color: var(--muted);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .svc:hover .svc-glyph {
    color: var(--olive);
    border-color: var(--olive-dim);
  }

  .svc-flag {
    font-size: 9px;
    letter-spacing: 0.3em;
    color: var(--ember);
    border: 1px solid var(--ember-dim);
    border-radius: 3px;
    padding: 4px 8px;
    margin-right: auto;
  }

  .svc-title {
    font-size: clamp(18px, 1.8vw, 22px);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .svc-body {
    color: var(--muted);
    font-size: 14.5px;
    font-weight: 300;
    flex: 1;
  }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; }
    .svc-flag { order: 3; width: 100%; text-align: center; }
  }
</style>
