<!-- ── The Cold Open ──────────────────────────────────────────
     Load:   "SYSTEMS" + dormant chip
     Scroll: chip activates → "with a SINE of LIFE." rises ──>
────────────────────────────────────────────────────────────── -->
<section class="hero" id="core">
  <div class="container hero-inner">
    <!-- status corners -->
    <div class="corners mono" aria-hidden="true">
      <span class="corner-l">[ 01 : CORE ]</span>
      <span class="corner-r" data-state>DORMANT</span>
    </div>

    <!-- Line 1 — always visible -->
    <h1 class="hero-h1">SYSTEMS</h1>

    <!-- The Chip — dormant until activated -->
    <div class="chip-wrap" aria-hidden="true">
      <svg viewBox="0 0 800 400" class="chip" role="img">
        <defs>
          <linearGradient id="chipBody" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#1a1a1a" />
            <stop offset="100%" stop-color="#050505" />
          </linearGradient>
          <filter id="mintGlow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="4" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
          <filter id="sineGlow" x="-60%" y="-60%" width="220%" height="220%">
            <feGaussianBlur stdDeviation="7" result="blur" />
            <feComposite in="SourceGraphic" in2="blur" operator="over" />
          </filter>
        </defs>

        <!-- circuit traces: base + mint pulses -->
        <g class="traces">
          <path d="M90 110 H210 V170 H280" fill="none" stroke="#232323" stroke-width="2" />
          <path d="M60 250 H230 V225 H280" fill="none" stroke="#232323" stroke-width="2" />
          <path d="M520 170 H590 V120 H710" fill="none" stroke="#232323" stroke-width="2" />
          <path d="M520 235 H610 V290 H730" fill="none" stroke="#232323" stroke-width="2" />
          <circle cx="90" cy="110" r="4" fill="#232323" />
          <circle cx="60" cy="250" r="4" fill="#232323" />
          <circle cx="710" cy="120" r="4" fill="#232323" />
          <circle cx="730" cy="290" r="4" fill="#232323" />
        </g>
        <g class="pulse-traces">
          <path class="ptrace" d="M90 110 H210 V170 H280" fill="none" stroke="var(--mint)" stroke-width="2" filter="url(#mintGlow)" />
          <path class="ptrace p2" d="M60 250 H230 V225 H280" fill="none" stroke="var(--mint)" stroke-width="2" filter="url(#mintGlow)" />
          <path class="ptrace p3" d="M520 170 H590 V120 H710" fill="none" stroke="var(--mint)" stroke-width="2" filter="url(#mintGlow)" />
          <path class="ptrace p4" d="M520 235 H610 V290 H730" fill="none" stroke="var(--mint)" stroke-width="2" filter="url(#mintGlow)" />
        </g>

        <!-- chip pins -->
        <g fill="#2c2c2c">
          <rect x="252" y="120" width="30" height="8" rx="2" />
          <rect x="252" y="160" width="30" height="8" rx="2" />
          <rect x="252" y="200" width="30" height="8" rx="2" />
          <rect x="252" y="240" width="30" height="8" rx="2" />
          <rect x="518" y="120" width="30" height="8" rx="2" />
          <rect x="518" y="160" width="30" height="8" rx="2" />
          <rect x="518" y="200" width="30" height="8" rx="2" />
          <rect x="518" y="240" width="30" height="8" rx="2" />
          <rect x="340" y="72" width="8" height="26" rx="2" />
          <rect x="396" y="72" width="8" height="26" rx="2" />
          <rect x="452" y="72" width="8" height="26" rx="2" />
          <rect x="340" y="302" width="8" height="26" rx="2" />
          <rect x="396" y="302" width="8" height="26" rx="2" />
          <rect x="452" y="302" width="8" height="26" rx="2" />
        </g>

        <!-- chip body -->
        <rect x="278" y="96" width="244" height="208" rx="16" fill="url(#chipBody)" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
        <rect x="284" y="102" width="232" height="196" rx="12" fill="none" stroke="rgba(255,255,255,0.05)" />

        <!-- inner cavity -->
        <rect x="306" y="124" width="188" height="128" rx="8" fill="#050505" stroke="rgba(255,255,255,0.07)" />

        <!-- the sine of life -->
        <path
          class="sine"
          d="M318 188 Q339 118 360 188 T402 188 T444 188 T482 188"
          fill="none"
          stroke="var(--mint)"
          stroke-width="3"
          stroke-linecap="round"
          filter="url(#sineGlow)"
        />
        <circle class="sine-pulse" r="5" fill="var(--mint)" filter="url(#mintGlow)">
          <animateMotion dur="5s" repeatCount="indefinite" path="M318 188 Q339 118 360 188 T402 188 T444 188 T482 188" />
        </circle>

        <!-- the copper plus -->
        <path class="plus" d="M470 138 v18 M461 147 h18" stroke="var(--copper)" stroke-width="3" stroke-linecap="round" />

        <!-- core label -->
        <text x="400" y="284" text-anchor="middle" class="chip-label">COS+ // CORE_NODE</text>
        <text x="400" y="180" text-anchor="middle" class="chip-ghost">cos θ</text>
      </svg>
    </div>

    <!-- Line 2 — rises on activation -->
    <h2 class="hero-h2">
      with a <em>SINE of LIFE.</em>
    </h2>

    <!-- decoder -->
    <div class="decoder mono" aria-hidden="true">
      <span class="decoder-v">V_02 :</span>
      <span class="decoder-word" data-decode>GOVERNED.</span>
    </div>

    <p class="hero-sub">
      COSINE+ AUTONOMOUS is an AI solutions company. We design precision
      websites, deploy <strong>recursive AiO systems</strong> that keep improving
      after launch, and build governed custom AI architectures for operations
      that can&rsquo;t afford drift.
    </p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#transmit">Initialize a build</a>
      <a class="btn" href="#nodes">View external nodes</a>
    </div>

    <!-- scroll cue — dormant only -->
    <div class="scroll-cue mono" aria-hidden="true">
      <span>Scroll to activate</span>
      <i></i>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 28px);
    padding-bottom: 90px;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .corners {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--ghost);
    margin-bottom: 10px;
  }
  .corner-r { transition: color 1s ease; }
  .hero.active .corner-r { color: var(--mint); }

  .hero-h1 {
    font-size: clamp(58px, 12vw, 124px);
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    animation: rise 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.35s backwards;
  }

  /* ── the chip ── */
  .chip-wrap {
    width: min(560px, 82vw);
    margin-block: clamp(4px, 1.5vw, 12px);
    animation: rise 1.4s ease-out 0.7s backwards;
  }
  .chip {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.8));
    transition: filter 1.5s ease, opacity 1.5s ease;
    opacity: 0.32;
    filter: grayscale(1);
  }
  .hero.active .chip { opacity: 1; filter: grayscale(0); }

  .sine {
    opacity: 0.28;
    transition: opacity 1.6s ease;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
  }
  .hero.active .sine {
    opacity: 1;
    animation: draw 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards,
      breathe 4s ease-in-out 2.6s infinite;
  }

  .sine-pulse { opacity: 0; transition: opacity 1s ease 2.2s; }
  .hero.active .sine-pulse { opacity: 1; }

  .plus { opacity: 0.35; transition: opacity 1.6s ease; }
  .hero.active .plus { opacity: 1; }

  .ptrace {
    stroke-dasharray: 40 260;
    stroke-dashoffset: 300;
    opacity: 0;
  }
  .hero.active .ptrace {
    opacity: 0.9;
    animation: traceflow 3.2s linear infinite;
  }
  .hero.active .p2 { animation-delay: 0.8s; }
  .hero.active .p3 { animation-delay: 1.6s; }
  .hero.active .p4 { animation-delay: 2.4s; }

  .chip-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    fill: var(--faint);
  }
  .chip-ghost {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: rgba(255, 255, 255, 0.06);
    letter-spacing: 0.2em;
  }

  /* ── line 2 / decoder / sub ── */
  .hero-h2 {
    font-size: clamp(30px, 5.5vw, 56px);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--muted);
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .hero-h2 em {
    font-weight: 800;
    font-style: italic;
    color: var(--ink);
  }
  .hero.active .hero-h2 { opacity: 1; transform: none; }

  .decoder {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    padding: 9px 20px;
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    background: rgba(10, 10, 10, 0.6);
    font-size: 13px;
    letter-spacing: 0.22em;
    opacity: 0;
    transition: opacity 1s ease 0.5s;
  }
  .hero.active .decoder { opacity: 1; }
  .decoder-v { color: var(--ghost); font-size: 10px; }
  .decoder-word { color: var(--ink); min-width: 130px; text-align: left; }

  .hero-sub {
    margin-top: 30px;
    max-width: 62ch;
    color: var(--muted);
    font-weight: 300;
    font-size: clamp(15px, 1.7vw, 17px);
    animation: rise 1.2s ease 1.1s backwards;
  }
  .hero-sub strong { color: var(--ink); font-weight: 500; }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
    justify-content: center;
    animation: rise 1.2s ease 1.3s backwards;
  }

  .scroll-cue {
    position: absolute;
    bottom: -64px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--ghost);
    transition: opacity 0.8s ease;
  }
  .scroll-cue i {
    width: 1px;
    height: 34px;
    background: linear-gradient(to bottom, var(--ghost), transparent);
    animation: drip 2s ease-in-out infinite;
  }
  .hero.active .scroll-cue { opacity: 0; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes traceflow {
    from { stroke-dashoffset: 300; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes drip {
    0%, 100% { transform: scaleY(0.4); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
  }

  @media (max-width: 640px) {
    .scroll-cue { bottom: -12px; }
    .hero { padding-bottom: 72px; }
  }
</style>

<script>
  // activation: scroll past 60px — or wake on its own after 4s
  const hero = document.querySelector(".hero");
  const state = document.querySelector("[data-state]");
  let active = false;
  const wake = () => {
    if (active) return;
    active = true;
    hero?.classList.add("active");
    if (state) state.textContent = "ACTIVE";
  };
  window.addEventListener("scroll", () => {
    if (window.scrollY > 60) wake();
    else if (window.scrollY < 15 && autoWoke) {
      active = false;
      hero?.classList.remove("active");
      if (state) state.textContent = "DORMANT";
    }
  }, { passive: true });

  let autoWoke = false;
  setTimeout(() => { autoWoke = true; wake(); }, 4000);

  // decoder scramble: GOVERNED → AUTONOMOUS → ALIVE
  const el = document.querySelector("[data-decode]");
  const words = ["GOVERNED.", "AUTONOMOUS.", "ALIVE."];
  const glyphs = "#.{}^!?*<>/\\|@$%";
  let wi = 0;
  const scrambleTo = (word: string, done: () => void) => {
    if (!el) return;
    let frame = 0;
    const total = 14;
    const tick = () => {
      frame++;
      const settled = Math.floor((frame / total) * word.length);
      let out = word.slice(0, settled);
      for (let i = settled; i < word.length; i++) {
        out += word[i] === " " ? " " : glyphs[Math.floor(Math.random() * glyphs.length)];
      }
      el!.textContent = out;
      if (frame < total) requestAnimationFrame(tick);
      else { el!.textContent = word; done(); }
    };
    tick();
  };
  const cycle = () => {
    if (!el) return;
    wi = (wi + 1) % words.length;
    const next = words[wi];
    scrambleTo(next, () => setTimeout(cycle, 2600));
  };
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    setTimeout(cycle, 3000);
  }
</script>
