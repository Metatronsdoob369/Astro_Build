---
// Cold open: original chip, original scale.
// SYSTEMS is thinner + gradient. Whole piece on one glass card.
// Presence lights it. Scroll does not.
---

<section class="hero" id="core">
  <div class="container hero-inner">
    <div class="plaque-glass">
      <h1 class="hero-h1">SYSTEMS</h1>

      <div class="chip-wrap" aria-hidden="true">
        <svg viewBox="0 0 800 400" class="chip" role="img">
          <defs>
            <linearGradient id="chipBody" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#3a3f43" />
              <stop offset="100%" stop-color="#23272a" />
            </linearGradient>
            <linearGradient id="systemsFade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f2f0ea" />
              <stop offset="100%" stop-color="#8a867c" />
            </linearGradient>
            <filter id="mintGlow" x="-40%" y="-40%" width="180%" height="180%">
              <feGaussianBlur stdDeviation="4" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
            <filter id="sineGlow" x="-60%" y="-60%" width="220%" height="220%">
              <feGaussianBlur stdDeviation="7" result="blur" />
              <feComposite in="SourceGraphic" in2="blur" operator="over" />
            </filter>
          </defs>

          <g class="traces">
            <path d="M90 110 H210 V170 H280" fill="none" stroke="#4a5054" stroke-width="2" />
            <path d="M60 250 H230 V225 H280" fill="none" stroke="#4a5054" stroke-width="2" />
            <path d="M520 170 H590 V120 H710" fill="none" stroke="#4a5054" stroke-width="2" />
            <path d="M520 235 H610 V290 H730" fill="none" stroke="#4a5054" stroke-width="2" />
            <circle cx="90" cy="110" r="4" fill="#4a5054" />
            <circle cx="60" cy="250" r="4" fill="#4a5054" />
            <circle cx="710" cy="120" r="4" fill="#4a5054" />
            <circle cx="730" cy="290" r="4" fill="#4a5054" />
          </g>
          <g class="pulse-traces">
            <path class="ptrace" d="M90 110 H210 V170 H280" fill="none" stroke="var(--olive-bright)" stroke-width="2" filter="url(#mintGlow)" />
            <path class="ptrace p2" d="M60 250 H230 V225 H280" fill="none" stroke="var(--olive-bright)" stroke-width="2" filter="url(#mintGlow)" />
            <path class="ptrace p3" d="M520 170 H590 V120 H710" fill="none" stroke="var(--olive-bright)" stroke-width="2" filter="url(#mintGlow)" />
            <path class="ptrace p4" d="M520 235 H610 V290 H730" fill="none" stroke="var(--olive-bright)" stroke-width="2" filter="url(#mintGlow)" />
          </g>

          <g fill="#4a5054">
            <rect x="252" y="120" width="30" height="8" rx="2" />
            <rect x="252" y="160" width="30" height="8" rx="2" />
            <rect x="252" y="200" width="30" height="8" rx="2" />
            <rect x="252" y="240" width="30" height="8" rx="2" />
            <rect x="518" y="120" width="30" height="8" rx="2" />
            <rect x="518" y="160" width="30" height="8" rx="2" />
            <rect x="518" y="200" width="30" height="8" rx="2" />
            <rect x="518" y="240" width="30" height="8" rx="2" />
            <rect x="340" y="72" width="8" height="26" rx="2" />
            <rect x="396" y="72" width="8" height="26" rx="2" />
            <rect x="452" y="72" width="8" height="26" rx="2" />
            <rect x="340" y="302" width="8" height="26" rx="2" />
            <rect x="396" y="302" width="8" height="26" rx="2" />
            <rect x="452" y="302" width="8" height="26" rx="2" />
          </g>

          <rect x="278" y="96" width="244" height="208" rx="16" fill="url(#chipBody)" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" />
          <rect x="284" y="102" width="232" height="196" rx="12" fill="none" stroke="rgba(255,255,255,0.05)" />
          <rect x="306" y="124" width="188" height="128" rx="8" fill="#1d2124" stroke="rgba(255,255,255,0.07)" />

          <path
            class="sine"
            d="M318 188 Q339 118 360 188 T402 188 T444 188 T482 188"
            fill="none"
            stroke="var(--olive-bright)"
            stroke-width="3"
            stroke-linecap="round"
            filter="url(#sineGlow)"
          />
          <circle class="sine-pulse" r="5" fill="var(--olive-bright)" filter="url(#mintGlow)">
            <animateMotion dur="5s" repeatCount="indefinite" path="M318 188 Q339 118 360 188 T402 188 T444 188 T482 188" />
          </circle>

          <path class="plus" d="M470 138 v18 M461 147 h18" stroke="var(--ember-bright)" stroke-width="3" stroke-linecap="round" />
        </svg>
      </div>

      <h2 class="hero-h2">
        with a <em>SINE of LIFE.</em>
      </h2>
    </div>

    <p class="hero-sub">
      The site that makes a cold call warm. Then a recursive AiO layer that
      gets better every day. Then, when the stakes are high, agents that live
      in a <strong>paint of your data</strong> — not a jail with folders.
    </p>

    <div class="hero-cta">
      <a class="btn btn-primary" href="#transmit">Initialize a build</a>
      <a class="btn" href="#nodes">View external nodes</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 28px);
    padding-bottom: 90px;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .plaque-glass {
    width: min(720px, 92vw);
    padding: clamp(28px, 4vw, 40px) clamp(20px, 3vw, 36px) clamp(24px, 3.4vw, 36px);
    border-radius: 20px;
    background: rgba(18, 18, 20, 0.5);
    backdrop-filter: blur(22px) saturate(1.12);
    -webkit-backdrop-filter: blur(22px) saturate(1.12);
    border: 1px solid rgba(236, 236, 232, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 24px 60px -28px rgba(0, 0, 0, 0.75);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-h1 {
    font-size: clamp(42px, 8.5vw, 86px);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    background: linear-gradient(180deg, #f2f0ea 0%, #a8a8a2 58%, #8a867c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .chip-wrap {
    width: min(560px, 82vw);
    margin-block: clamp(4px, 1.5vw, 12px);
  }
  .chip {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 50px rgba(0, 0, 0, 0.8));
    transition: filter 1.5s ease, opacity 1.5s ease;
    opacity: 0.32;
    filter: grayscale(1);
  }
  .hero.lit .chip { opacity: 1; filter: grayscale(0) drop-shadow(0 20px 50px rgba(0, 0, 0, 0.8)); }

  .sine {
    opacity: 0.28;
    transition: opacity 1.6s ease;
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
  }
  .hero.lit .sine {
    opacity: 1;
    animation: draw 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards,
      breathe 4s ease-in-out 2.6s infinite;
  }

  .sine-pulse { opacity: 0; transition: opacity 1s ease 2.2s; }
  .hero.lit .sine-pulse { opacity: 1; }

  .plus { opacity: 0.35; transition: opacity 1.6s ease; }
  .hero.lit .plus { opacity: 1; }

  .ptrace {
    stroke-dasharray: 40 260;
    stroke-dashoffset: 300;
    opacity: 0;
  }
  .hero.lit .ptrace {
    opacity: 0.9;
    animation: traceflow 3.2s linear infinite;
  }
  .hero.lit .p2 { animation-delay: 0.8s; }
  .hero.lit .p3 { animation-delay: 1.6s; }
  .hero.lit .p4 { animation-delay: 2.4s; }

  .hero-h2 {
    font-size: clamp(22px, 4vw, 40px);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--muted);
    letter-spacing: 0.01em;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 1.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .hero-h2 em {
    font-weight: 600;
    font-style: italic;
    color: var(--ink);
  }
  .hero.lit .hero-h2 { opacity: 1; transform: none; }

  .hero-sub {
    margin-top: 30px;
    max-width: 62ch;
    color: var(--muted);
    font-weight: 300;
    font-size: clamp(15px, 1.7vw, 17px);
  }
  .hero-sub strong { color: var(--ink); font-weight: 500; }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
    justify-content: center;
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes traceflow {
    from { stroke-dashoffset: 300; }
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-h2, .sine, .plus, .ptrace, .sine-pulse, .chip {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      filter: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script>
  const hero = document.querySelector(".hero");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let lit = false;
  const ignite = () => {
    if (lit || !hero) return;
    lit = true;
    hero.classList.add("lit");
  };
  if (reduced) {
    ignite();
  } else {
    const onPresence = () => ignite();
    window.addEventListener("pointermove", onPresence, { once: true, passive: true });
    window.addEventListener("pointerdown", onPresence, { once: true, passive: true });
    setTimeout(ignite, 2200);
  }
</script>
