---
// TopoBand — full-bleed field-survey moment: contour field + dashed survey
// route + waypoints. The strong "photo moment" of the topo feel.
import TopoField from "./TopoField.astro";

interface Waypoint {
  x: number; // in 1440 x 320 route space
  y: number;
  label: string;
  sub?: string;
  below?: boolean;
  live?: boolean;
}

interface Props {
  seed?: number;
  kicker?: string;
  note?: string;
  waypoints?: Waypoint[];
  route?: string; // svg path d in 1440x320 space
}

const {
  seed = 21,
  kicker = "[ SURVEY ROUTE — LEG 04 ]",
  note = "ELEV +412M",
  waypoints = [
    { x: 130, y: 215, label: "WP-01 · SENSE", sub: "telemetry on" },
    { x: 500, y: 120, label: "WP-02 · MODEL", sub: "pattern map" },
    { x: 880, y: 225, label: "WP-03 · REFINE", sub: "draft deltas" },
    { x: 1250, y: 105, label: "WP-04 · SERVE", sub: "ship + learn", live: true },
  ],
  route = "M130 215 C 250 215 380 120 500 120 S 740 225 880 225 S 1110 105 1250 105",
} = Astro.props;

const pct = (v: number, m: number) => `${((v / m) * 100).toFixed(2)}%`;
---

<section class="band" aria-hidden="true">
  <TopoField seed={seed} h={560} w={1440} cols={96} rows={52} levels={8} preserve="none" class="band-topo" />

  <svg class="band-route" viewBox="0 0 1440 320" preserveAspectRatio="none">
    <path d={route} fill="none" stroke="var(--ember)" stroke-width="2" stroke-dasharray="10 8" stroke-linecap="round" opacity="0.85" />
  </svg>

  {waypoints.map((wp) => (
    <div
      class:list={["wp", { below: wp.below, live: wp.live }]}
      style={`left: ${pct(wp.x, 1440)}; top: ${pct(wp.y, 320)};`}
    >
      <span class="wp-dot"></span>
      <span class="wp-label mono">{wp.label}</span>
      {wp.sub && <span class="wp-sub mono">{wp.sub}</span>}
    </div>
  ))}

  <div class="band-corner tl mono">{kicker}</div>
  <div class="band-corner tr mono">{note}</div>
  <div class="band-corner bl mono">CONTOUR INT. 40M — DATUM WGS84</div>
  <div class="band-corner br mono">⌖ N 33°31′ W 86°48′</div>
</section>

<style>
  .band {
    position: relative;
    height: clamp(300px, 34vw, 420px);
    border-block: 1px solid var(--line-soft);
    overflow: hidden;
    background: var(--bg);
    z-index: 1;
  }

  .band-topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .band-route {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wp {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  .wp-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg-raised);
    border: 2px solid var(--graphite);
    box-shadow: 0 0 0 4px rgba(46, 50, 54, 0.08);
    order: 2;
  }
  .wp-label { order: 1; font-size: 9.5px; letter-spacing: 0.18em; color: var(--ink); white-space: nowrap; }
  .wp-sub { order: 3; font-size: 8.5px; letter-spacing: 0.14em; color: var(--faint); white-space: nowrap; }
  .wp.below .wp-dot { order: 1; }
  .wp.below .wp-label { order: 2; }
  .wp.below .wp-sub { order: 3; }

  .wp.live .wp-dot {
    border-color: var(--ember);
    animation: wppulse 2.4s ease-in-out infinite;
  }
  .wp.live .wp-label { color: var(--ember); }
  @keyframes wppulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(194, 85, 31, 0.18); }
    50% { box-shadow: 0 0 0 8px rgba(194, 85, 31, 0.05); }
  }

  .band-corner {
    position: absolute;
    font-size: 9.5px;
    letter-spacing: 0.22em;
    color: var(--faint);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    padding: 4px 10px;
    border: 1px solid var(--line-soft);
    border-radius: 3px;
    backdrop-filter: blur(2px);
  }
  .tl { top: 16px; left: clamp(16px, 3vw, 36px); }
  .tr { top: 16px; right: clamp(16px, 3vw, 36px); color: var(--olive); }
  .bl { bottom: 16px; left: clamp(16px, 3vw, 36px); }
  .br { bottom: 16px; right: clamp(16px, 3vw, 36px); color: var(--ember); }

  @media (max-width: 720px) {
    .wp-sub, .bl { display: none; }
    .wp-label { font-size: 8.5px; }
    .band-corner { font-size: 8.5px; }
  }
</style>
