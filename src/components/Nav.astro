---
const links = [
  { href: "#design", label: "DESIGN", num: "02" },
  { href: "#systems", label: "SYSTEMS", num: "03" },
  { href: "#nodes", label: "NODES", num: "05" },
  { href: "#protocol", label: "PROTOCOL", num: "06" },
];
---

<header class="nav" id="top">
  <div class="container nav-inner">
    <!-- Brand / Logo Plaque -->
    <div class="brand-row">
      <a class="plaque" href="#top" aria-label="COSINE+ AUTONOMOUS — home">
        <div class="plaque-scan" aria-hidden="true"></div>
        <div class="plaque-face">
          <svg viewBox="0 0 48 22" width="42" height="20" aria-hidden="true" class="plaque-wave">
            <path d="M2 14 Q8 2 14 14 T26 14 T38 14" fill="none" stroke="var(--olive-bright)" stroke-width="2.2" stroke-linecap="round"></path>
            <path d="M43 3 v8 M39 7 h8" stroke="var(--ember-bright)" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <span class="plaque-name">COSINE<em>+</em></span>
        </div>
        <div class="plaque-screws" aria-hidden="true">
          <i></i><i class="slider"></i><i></i>
        </div>
      </a>

      <div class="nav-divider" aria-hidden="true"></div>

      <div class="status mono" aria-hidden="true">
        <span class="pulse-dot"></span>
        STATUS: GOVERNED
      </div>
    </div>

    <!-- Desktop links -->
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a class="decode mono" href={l.href} data-text={l.label}>{l.label}</a>
      ))}
      <a class="btn btn-primary nav-cta" href="#transmit">Initialize</a>
    </nav>

    <button class="nav-toggle mono" aria-expanded="false" aria-controls="mobile-menu">
      Menu
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    {links.map((l) => <a href={l.href} class="mono">{l.label}</a>)}
    <a href="#transmit" class="btn btn-primary">Initialize</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    border-bottom: 1px solid transparent;
  }
  .nav.scrolled {
    background: rgba(242, 239, 231, 0.87);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line-soft);
  }

  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand-row { display: flex; align-items: center; gap: 18px; }

  /* ---- the plaque ---- */
  .plaque {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px 6px 8px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-right-color: rgba(0, 0, 0, 0.8);
    border-bottom-color: rgba(0, 0, 0, 0.8);
    background: linear-gradient(to bottom, #3a3f43, #23272a);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.05), 0 4px 6px rgba(0, 0, 0, 0.4);
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  .plaque:active { transform: scale(0.98); }

  .plaque-scan {
    position: absolute;
    top: 0; bottom: 0; left: -160%;
    width: 100%;
    background: linear-gradient(to right, transparent, var(--olive-dim), transparent);
    transition: left 1.2s ease-in-out;
    pointer-events: none;
  }
  .plaque:hover .plaque-scan { left: 160%; }

  .plaque-face {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.04);
    background: #1d2124;
    padding: 8px 14px;
    box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.6);
    transition: filter 0.8s ease;
  }
  .plaque:hover .plaque-face { filter: brightness(1.25); }

  .plaque-name {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.14em;
    color: #f2efe7;
  }
  .plaque-name em {
    color: var(--ember-bright);
    font-style: normal;
    display: inline-block;
    margin-left: 2px;
    animation: breathe 2.2s ease-in-out infinite;
  }

  .plaque-screws {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-self: stretch;
    padding: 2px 0;
    opacity: 0.6;
    transition: opacity 0.5s ease;
  }
  .plaque:hover .plaque-screws { opacity: 1; }
  .plaque-screws i {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: #4a5054;
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.1);
  }
  .plaque-screws i.slider {
    height: 14px;
    width: 4px;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.8);
    transition: background 0.7s ease, box-shadow 0.7s ease;
  }
  .plaque:hover .plaque-screws i.slider {
    background: var(--olive-bright);
    box-shadow: 0 0 8px rgba(163, 177, 138, 0.6);
  }

  .nav-divider { width: 1px; height: 20px; background: var(--line); }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.24em;
    color: var(--faint);
  }

  /* ---- decode links (mint typewriter reward) ---- */
  .nav-links { display: flex; align-items: center; gap: 30px; }
  .decode {
    position: relative;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--muted);
    padding: 4px 0;
    transition: color 0.3s ease;
  }
  .decode::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    padding: 4px 0;
    color: var(--olive);
    border-right: 2px solid var(--ember);
    width: 0%;
    overflow: hidden;
    white-space: nowrap;
    transition: width 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .decode:hover { color: transparent; }
  .decode:hover::after {
    width: 100%;
    filter: drop-shadow(0 0 8px rgba(91, 101, 80, 0.5));
  }

  .nav-cta { padding: 11px 20px; }

  .nav-toggle {
    display: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 10px 16px;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--ink);
    text-transform: uppercase;
  }
  .nav-toggle:hover { border-color: var(--olive); color: var(--olive); }

  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid var(--line-soft);
    background: rgba(242, 239, 231, 0.97);
    backdrop-filter: blur(12px);
    padding: 18px clamp(20px, 4vw, 44px) 26px;
  }
  .mobile-menu a:not(.btn) {
    color: var(--muted);
    font-size: 13px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
    transition: color 0.2s ease;
  }
  .mobile-menu a:not(.btn):hover { color: var(--olive); }
  .mobile-menu .btn { margin-top: 18px; justify-content: center; }

  @media (max-width: 1080px) {
    .status { display: none; }
    .nav-divider { display: none; }
  }
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-toggle { display: block; }
    .mobile-menu.open { display: flex; }
  }
</style>

<script>
  // plaque shadow on scroll
  const nav = document.querySelector(".nav");
  const onScroll = () => nav?.classList.toggle("scrolled", window.scrollY > 50);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // mobile menu
  const toggle = document.querySelector(".nav-toggle");
  const menu = document.querySelector(".mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    })
  );
</script>
