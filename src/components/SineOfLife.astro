---
// SineOfLife — the recurring motif. One thin line. Flat until it is alive;
// alive, it lifts into a sine and breathes (amplitude only, slow).
// The parent decides when it is alive by adding class "alive" to the root element.
// Optional `plus`: the identifier, placed after the line. Off by default — it is
// placed, never tossed about. No glow, no dash race, no travelling dot.
// Reduced motion: lifted, still, plus visible.
interface Props {
  amplitude?: number; // 0–1, share of the line's available height
  period?: number;    // seconds per breath
  color?: string;
  opacity?: number;
  cycles?: number;    // sine cycles across the width
  plus?: boolean;
  plusColor?: string;
  class?: string;
}
const {
  amplitude = 0.55,
  period = 7.5,
  color = "var(--olive)",
  opacity = 0.6,
  cycles = 1.5,
  plus = false,
  plusColor = "var(--ember)",
  class: cls = "",
} = Astro.props;

const W = 800;
const H = 120;
const mid = H / 2;
const A = Math.max(0.05, Math.min(1, amplitude)) * (H / 2 - 6);
const pts: string[] = [];
for (let x = 0; x <= W; x += 8) {
  const y = mid - A * Math.sin((2 * Math.PI * cycles * x) / W);
  pts.push(`${x === 0 ? "M" : "L"}${x} ${y.toFixed(2)}`);
}
const d = pts.join("");
---

<span
  class:list={["sol", cls]}
  style={`--sol-period:${period}s;--sol-color:${color};--sol-opacity:${opacity};--sol-plus:${plusColor}`}
>
  <svg class="sol-line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
    <line class="sol-base" x1="0" y1={mid} x2={W} y2={mid} />
    <g class="sol-wave">
      <path d={d} />
    </g>
  </svg>
  {plus && (
    <svg class="sol-plus" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 3.5 V16.5 M3.5 10 H16.5" />
    </svg>
  )}
</span>

<style>
  .sol {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    height: 100%;
  }
  .sol-line {
    display: block;
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    overflow: visible;
  }
  .sol-base {
    stroke: var(--sol-color);
    stroke-width: 1;
    opacity: 0.22;
    vector-effect: non-scaling-stroke;
  }
  .sol-wave path {
    fill: none;
    stroke: var(--sol-color);
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: var(--sol-opacity);
  }
  .sol-wave {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transform: scaleY(0.001);
    transition: transform 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .sol.alive .sol-wave {
    transform: scaleY(1);
    animation: sol-breathe var(--sol-period) ease-in-out 2.4s infinite;
  }
  @keyframes sol-breathe {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.55); }
  }

  /* the identifier: one "+", same weight as the line, arrives after the line has lifted */
  .sol-plus {
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    overflow: visible;
    opacity: 0;
    transition: opacity 1.4s ease 1.8s;
  }
  .sol-plus path {
    fill: none;
    stroke: var(--sol-plus);
    stroke-width: 1.6;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.9;
  }
  .sol.alive .sol-plus { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .sol-wave, .sol.alive .sol-wave {
      transform: scaleY(1) !important;
      transition: none !important;
      animation: none !important;
    }
    .sol-plus { opacity: 1 !important; transition: none !important; }
  }
</style>
