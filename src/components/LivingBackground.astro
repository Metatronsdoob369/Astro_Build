<!-- Living Background — breathing coordinate grid on bone paper with a
     lagging mouse spotlight. The page feels alive; it notices you slowly. -->
<canvas id="living-bg" aria-hidden="true"></canvas>

<style>
  #living-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.getElementById("living-bg") as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext("2d");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let w = 0, h = 0;
    const resize = () => {
      w = canvas!.width = window.innerWidth;
      h = canvas!.height = window.innerHeight;
    };
    window.addEventListener("resize", resize);
    resize();

    // lazy spotlight position (the "it takes a moment to notice you" lag)
    let mx = -9999, my = -9999;
    let tx = mx, ty = my;
    window.addEventListener("mousemove", (e) => {
      tx = e.clientX;
      ty = e.clientY;
    });

    let time = 0;
    const render = () => {
      time += 0.0022;
      mx += (tx - mx) * 0.015;
      my += (ty - my) * 0.015;

      ctx!.clearRect(0, 0, w, h);

      const spacing = 84;
      const xCount = Math.ceil(w / spacing) + 1;
      const yCount = Math.ceil(h / spacing) + 1;
      const maxDist = Math.max(w, h) / 1.6;

      for (let x = 0; x < xCount; x++) {
        for (let y = 0; y < yCount; y++) {
          // gentle sine drift — the grid breathes
          const px = x * spacing + Math.sin(time + y * 0.35) * 14;
          const py = y * spacing + Math.cos(time + x * 0.35) * 14;

          const dc = Math.hypot(px - w / 2, py - h / 2);
          const base = Math.max(0, 1 - dc / maxDist) * 0.3;

          // ranger-green reward near the lagging spotlight
          const dm = Math.hypot(px - mx, py - my);
          const glow = Math.max(0, 1 - dm / 240);

          const o = base * (0.5 + glow * 2);
          if (o <= 0.02) continue;

          if (glow > 0.3) {
            const g = Math.min(1, (glow - 0.3) / 0.7);
            ctx!.fillStyle = `rgba(91,101,80,${Math.min(0.55, o * 0.6)})`;
            const r = 1.2 + g * 1.6;
            ctx!.beginPath();
            ctx!.arc(px, py, r, 0, Math.PI * 2);
            ctx!.fill();
          } else {
            ctx!.fillStyle = `rgba(46,50,54,${o * 0.45})`;
            ctx!.fillRect(px - 0.75, py - 0.75, 1.5, 1.5);
          }
        }
      }
      if (!reduced) requestAnimationFrame(render);
    };

    if (reduced) {
      render();
    } else {
      requestAnimationFrame(render);
    }
  }
</script>
