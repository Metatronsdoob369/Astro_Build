---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import TopoLayer from "../components/TopoLayer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "COSINE+ AUTONOMOUS — Systems, with a sine of life",
  description =
    "COSINE+ AUTONOMOUS. Custom sites that warm a cold call. Recursive AiO that gets better every day. Agents in a paint of your data — not a jail with folders.",
} = Astro.props;

// Signal audit pack. Rendered only when a public Signal origin and this site's embed key are
// set at build time (PUBLIC_SIGNAL_ORIGIN, PUBLIC_SIGNAL_KEY); the production build carries
// nothing until Signal has a public https origin.
const signalOrigin = import.meta.env.PUBLIC_SIGNAL_ORIGIN;
const signalKey = import.meta.env.PUBLIC_SIGNAL_KEY;
const signalSrc =
  signalOrigin && signalKey
    ? `${String(signalOrigin).replace(/\/$/, "")}/api/pack?key=${encodeURIComponent(String(signalKey))}`
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e0e10" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700&family=Inter:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {signalSrc && <script is:inline defer src={signalSrc}></script>}
  </head>
  <body>
    <TopoLayer />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // scroll-reveal observer
      const els = document.querySelectorAll("[data-reveal]");
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -6% 0px" }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
